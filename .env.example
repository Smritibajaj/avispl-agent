# --- Ingestion (packages/ingest) ---
# Firecrawl works keyless on a rate-limited free tier; add a key for higher limits.
FIRECRAWL_API_KEY=

# --- HydraDB (packages/hydra, used server-side by apps/web) ---
HYDRADB_API_KEY=
HYDRADB_BASE_URL=https://api.hydradb.com
HYDRADB_DATABASE=avispl_meeting_room_dev
HYDRADB_COLLECTION=meeting-room-journey

# --- Chat app (apps/web) ---
# mock = fixtures, no keys needed. hydra = real HydraDB.
KNOWLEDGE_BACKEND=mock
# Claude model id only (non-Claude ids are refused). Direct id or AI Gateway id.
# Empty = claude-opus-5-5. Cheaper: claude-sonnet-5-5. (AI Gateway ids use dots: anthropic/claude-opus-5.5)
CHAT_MODEL=
# Needed for AI Gateway locally; on Vercel use OIDC (no key).
AI_GATEWAY_API_KEY=
# Direct Anthropic API key (used before the gateway when set)
ANTHROPIC_API_KEY=
